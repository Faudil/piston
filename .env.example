# Copy this file to `.env` at the repository root and fill in the values.
# The same file is read by `bun dev` (local) and `docker compose up` (production).

# --- Required ---------------------------------------------------------------

# Anthropic API key, from https://console.anthropic.com/settings/keys
# Read server-side only (Nuxt runtimeConfig), never exposed to the browser.
ANTHROPIC_API_KEY=

# Secret used to encrypt session cookies. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=

# PostgreSQL connection string used by `bun dev`, migrations and the seed script.
# Matches docker-compose.dev.yml. The production compose file builds its own URL
# from the POSTGRES_* values below and ignores this one.
DATABASE_URL=postgres://piston:piston@localhost:5432/piston

# --- Optional ---------------------------------------------------------------

# Claude model used for every generation.
CLAUDE_MODEL=claude-sonnet-5-5

# Maximum number of Claude generations per user and per day.
DAILY_GENERATION_LIMIT=30

# Global caps shared by ALL users, so spam cannot overcharge you (see
# "Limiting costs" in docs/GETTING_STARTED.md). Also set a spend limit in the
# Anthropic Console: these are a safety net, not the hard stop.
# Claude calls per rolling 24 hours, whole server.
CLAUDE_GLOBAL_DAILY_LIMIT=300
# Estimated Claude spend per calendar month, in USD.
CLAUDE_MONTHLY_BUDGET_USD=25
# Tavily calls per rolling 24 hours, whole server.
TAVILY_GLOBAL_DAILY_LIMIT=300
# Tavily credits per calendar month (1000 = the free tier).
TAVILY_MONTHLY_CREDITS=1000

# Enables job search and importing offers from a link. Free tier at https://tavily.com
# Leave empty to hide these features.
TAVILY_API_KEY=

# Session cookie lifetime in seconds, counted from login (default: 30 days).
# Changing a password logs the user out everywhere, whatever this value.
SESSION_MAX_AGE=2592000

# Read the client IP from X-Forwarded-For, for login throttling. Only enable it
# when the app is reachable ONLY through exactly one reverse proxy; the
# proxy override (docker-compose.proxy.yml) already sets it.
TRUST_PROXY=false

# Send the Content-Security-Policy as report-only: nothing is blocked, the
# browser console lists what would be. For trying a change safely.
CSP_REPORT_ONLY=false

# --- Production (docker-compose.yml) ----------------------------------------

# Credentials of the bundled Postgres container. Change the password.
POSTGRES_USER=piston
POSTGRES_PASSWORD=change-me
POSTGRES_DB=piston

# Host port the app is published on.
PISTON_PORT=3000

# --- Behind nginx-proxy (docker-compose.proxy.yml) ---------------------------

# Public domain of the app, e.g. piston.example.com (DNS must point to the server).
PISTON_DOMAIN=
# E-mail given to Let's Encrypt for certificate notices.
LETSENCRYPT_EMAIL=
# Docker network shared with the nginx-proxy container.
PROXY_NETWORK=nginx-proxy

# --- Backups (docker-compose.yml, `backup` service) --------------------------

# Hour (UTC, 0-23) of the daily database dump, and how many days to keep them.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14
# Optional off-site copy: an S3 URL such as s3://my-bucket/piston, with its
# credentials. For a non-AWS provider (Cloudflare R2, Backblaze B2, Scaleway...)
# also set AWS_ENDPOINT_URL. Leave BACKUP_S3_URL empty to keep dumps local only.
BACKUP_S3_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT_URL=
