{
  "name": "piston",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=2",
    "lint": "turbo run lint typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "cd packages/db && bun run generate",
    "db:migrate": "cd packages/db && bun run migrate",
    "db:seed": "cd packages/db && bun run seed",
    "prepare": "husky",
    "db:invite": "cd packages/db && bun run invite",
    "user:list": "cd packages/db && bun run user list",
    "user:reset-password": "cd packages/db && bun run user reset-password",
    "user:make-admin": "cd packages/db && bun run user make-admin",
    "user:revoke-admin": "cd packages/db && bun run user revoke-admin",
    "e2e": "bun run e2e:build && bun run e2e:run",
    "e2e:build": "cd apps/web && NUXT_E2E_BUILD_DIR=.nuxt-e2e bun --bun nuxt build",
    "e2e:run": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.17.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "^1.4.3",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.9",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,json,md,yml,yaml,css}": "prettier --write"
  }
}
