{
  "name": "@piston/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, client and seed script.",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./migrate": "./src/migrate.ts",
    "./fixtures": "./src/fixtures/sample-resume.ts",
    "./password": "./src/password.ts",
    "./admin": "./src/admin.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "bun --env-file=../../.env src/migrate-cli.ts",
    "seed": "bun --env-file=../../.env src/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "test": "bun --bun vitest run",
    "invite": "bun --env-file=../../.env src/invite-cli.ts",
    "user": "bun --env-file=../../.env src/user-cli.ts"
  },
  "dependencies": {
    "@adonisjs/hash": "^9.1.1",
    "@piston/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.0.5"
  }
}
