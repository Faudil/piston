{
  "name": "@piston/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun nuxt dev --dotenv ../../.env",
    "build": "bun --bun nuxt build",
    "preview": "bun --env-file=../../.env .output/server/index.mjs",
    "postinstall": "bun --bun nuxt prepare",
    "lint": "eslint .",
    "typecheck": "bun --bun nuxt typecheck",
    "test": "bun --bun vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@napi-rs/canvas": "0.1.80",
    "@nuxt/ui": "^4.12.0",
    "@piston/db": "workspace:*",
    "@piston/cv-render": "workspace:*",
    "@piston/prompts": "workspace:*",
    "@piston/shared": "workspace:*",
    "nuxt": "^4.6.2",
    "nuxt-auth-utils": "^0.5.32",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pdfmake": "^0.3.12",
    "tailwindcss": "^4.3.3",
    "vue": "latest",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.4",
    "@types/bun": "latest",
    "@types/pdfmake": "^0.3.3",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "h3": "^1.15.11",
    "happy-dom": "^21.0.3",
    "jszip": "^3.10.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
